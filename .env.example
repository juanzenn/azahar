# Azahar — shop configuration
#
# Copy to `.env.local` for local development, or set these in your host's
# environment (Vercel, Netlify, Cloudflare Pages, a CI job) for a real deploy.
#
# Read at BUILD time. The site is a static export with no runtime server, so
# changing any value here means rebuilding and redeploying — there is nothing to
# restart. Everything is inlined into the exported HTML.
#
# Every variable is optional. An unset one falls back to a placeholder and the
# build prints a warning listing what it did not find, so a clone of this repo
# builds and runs as a demo shop. A malformed one (`ENABLED=maybe`,
# `FEE_CENTS=5.50`) fails the build on purpose.
#
# Set but empty is a third, deliberate answer: the value is treated as genuinely
# blank rather than missing, and rows with no value are simply not rendered.
# That is how a shop with a Binance Pay ID and no wallet address says so.
#
# These are all NEXT_PUBLIC_ because they are public — a storefront prints its
# phone number and its bank details on the page. Never put anything secret here.

# --- The shop -----------------------------------------------------------------

# wa.me form: country code + digits only. No `+`, no leading zero, no dashes or
# spaces. Checkout builds its WhatsApp deep-link from this.
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER=584121234567

# The same number as a human reads or dials it.
NEXT_PUBLIC_SHOP_PHONE_DISPLAY=0412-123-4567

NEXT_PUBLIC_SHOP_HOURS=Lunes a sábado, 8:00 am – 6:00 pm
NEXT_PUBLIC_SHOP_LOCATION=Caracas, Venezuela

# The flat delivery fee in USD CENTS — 500 is $5.00. Use 0 to deliver free.
# Retiro en tienda is always free regardless of this value.
NEXT_PUBLIC_SHOP_DELIVERY_FEE_CENTS=500

# --- Payment rails ------------------------------------------------------------
#
# Each rail's *_ENABLED accepts true/false, 1/0, si/no, yes/no, on/off.
# Disabling a rail removes it from checkout and from the footer's list of
# accepted methods — it is not shown greyed out, because every rail on the page
# is an invitation to send money somewhere.

# Pago Móvil: teléfono + cédula/RIF + the bank's 4-digit code. No account number.
NEXT_PUBLIC_PAY_PAGO_MOVIL_ENABLED=true
NEXT_PUBLIC_PAY_PAGO_MOVIL_PHONE=0412-1234567
NEXT_PUBLIC_PAY_PAGO_MOVIL_ID=V-12.345.678
NEXT_PUBLIC_PAY_PAGO_MOVIL_BANK_CODE=0102

# Transferencia bancaria: 20-digit account number, holder, cédula/RIF, bank.
NEXT_PUBLIC_PAY_TRANSFERENCIA_ENABLED=true
NEXT_PUBLIC_PAY_TRANSFERENCIA_ACCOUNT_NUMBER=01020000000000000000
NEXT_PUBLIC_PAY_TRANSFERENCIA_HOLDER=Floristería Azahar, C.A.
NEXT_PUBLIC_PAY_TRANSFERENCIA_ID=J-12345678-9
NEXT_PUBLIC_PAY_TRANSFERENCIA_BANK=Banco de Venezuela

# Zelle: the registered email or US phone — whichever the shop signed up with.
NEXT_PUBLIC_PAY_ZELLE_ENABLED=true
NEXT_PUBLIC_PAY_ZELLE_ACCOUNT=pagos@azahar.example
NEXT_PUBLIC_PAY_ZELLE_HOLDER=Azahar Flowers LLC

# Binance / USDT. The network labels the wallet, and USDT sent to the right
# address on the wrong chain is gone — so if you set a wallet, set its network.
# Leave either value empty if the shop only has the other one.
NEXT_PUBLIC_PAY_BINANCE_ENABLED=true
NEXT_PUBLIC_PAY_BINANCE_PAY_ID=123456789
NEXT_PUBLIC_PAY_BINANCE_WALLET=TJ4kL9mNp2QrS5tUvW8xY1zA3bC6dE7fG
NEXT_PUBLIC_PAY_BINANCE_NETWORK=TRC20

# Efectivo (pago contra entrega). Nothing to configure but whether it is offered.
NEXT_PUBLIC_PAY_EFECTIVO_ENABLED=true


# ── Build switches ───────────────────────────────────────────────────────────
#
# Not shop configuration, and deliberately not NEXT_PUBLIC_: these are read by
# the build itself and never reach a page.

# Refuse to build if any variable above is unset, instead of warning and falling
# back to placeholders. Set this in a real deploy: the placeholders include a
# Pago Móvil number and a Zelle account that are not this shop's, and a static
# export prints them into every page. Leave it unset to build the demo shop.
# AZAHAR_STRICT_CONFIG=1
